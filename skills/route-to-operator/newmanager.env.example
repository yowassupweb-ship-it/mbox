# Доступ к менеджерской программе для навыка route-to-operator.
# 1. Скопируйте этот файл в ту же папку под именем newmanager.env
# 2. Замените почту и пароль своими
# newmanager.env никому не пересылайте и не коммитьте: в нём пароль.
NEWMANAGER_URL=http://newmanager.vs
NEWMANAGER_EMAIL=ваша_почта@example.ru
NEWMANAGER_PASSWORD=ваш_пароль

+++ b/src/styles/workbench.css
@@ -3672,8 +3672,13 @@ li.is-drop-target > .wb-tree-project { box-shadow: inset 0 2px 0 var(--accent-co
 .wb-note-save.is-error { color: var(--state-danger); }
 .wb-note-save.is-error > svg { color: currentColor; }
 .wb-note-spinner { width: 11px; height: 11px; border: 1.5px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: wb-ssh-spin 0.8s linear infinite; }
-.wb-note-flag { display: inline-flex; align-items: center; gap: 4px; height: 18px; padding: 0 7px; border-radius: var(--radius-pill); background: var(--wb-hover); color: var(--text-2); font-size: var(--text-2xs); }
+.wb-note-flag { flex: none; display: inline-flex; align-items: center; gap: 4px; height: 18px; padding: 0 7px; border-radius: var(--radius-pill); background: var(--wb-hover); color: var(--text-2); font-size: var(--text-2xs); }
 .wb-note-notice { overflow: hidden; color: var(--state-warn); text-overflow: ellipsis; }
+/* Мало места: сжимается «Изменено …» с многоточием, плашки «Закреплена» / «По ссылке» остаются целыми
+   (раньше общий overflow: hidden строки статуса резал их на полуслове). */
+.wb-note-status > .wb-note-save { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.wb-note-status > .wb-note-save > svg { flex: none; }
+.wb-note-save-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
 
 .wb-note-tools { display: flex; flex: none; align-items: center; gap: 2px; margin-left: auto; }
 .wb-note-divider { width: 1px; height: 16px; margin: 0 6px; background: var(--wb-line); }

+.seo-metrica-counter > header { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2); }
+.seo-metrica-counter > header > div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.seo-metrica-counter > header strong { font-size: var(--text-sm); font-weight: var(--weight-semibold); }
+.seo-metrica-counter > header span { color: var(--text-muted); font-size: var(--text-xs); }
+.seo-metrica-remove {
+  flex: none;
+  display: grid;
+  place-items: center;
+  width: 32px;
+  height: 32px;
+  border: 0;
+  border-radius: var(--radius-sm);
+  background: none;
+  color: var(--text-muted);
+  cursor: pointer;
+}
+.seo-metrica-remove:hover { background: var(--surface-hover); color: var(--state-danger); }
+.seo-metrica-goals { display: flex; flex-direction: column; gap: 1px; margin: 0; padding: 0; list-style: none; }
+.seo-metrica-goals li {
+  display: grid;
+  grid-template-columns: minmax(0, 1.2fr) 170px minmax(0, 1.5fr);
+  align-items: center;
+  gap: var(--space-2);
+  padding: 6px 8px;
+  border-radius: var(--radius-sm);
+}
+.seo-metrica-goals li:nth-child(odd) { background: color-mix(in srgb, var(--text-main) 3%, transparent); }
+.seo-metrica-goals li.is-on { box-shadow: inset 2px 0 0 var(--accent-color); }
+.seo-metrica-goal-head { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
+.seo-metrica-goal-name { overflow-wrap: anywhere; color: var(--text-main); font-size: var(--text-sm); }
+.seo-metrica-goal-name em { color: var(--state-warn); font-style: normal; }
+.seo-metrica-goal-meta { color: var(--text-muted); font-size: var(--text-2xs); font-variant-numeric: tabular-nums; }
+.seo-metrica-goals select,
+.seo-metrica-goals textarea {
+  min-width: 0;
+  padding: 6px 8px;
+  border: var(--border-width) solid var(--border-color);
+  border-radius: var(--radius-sm);
+  background: var(--element-bg);
+  color: var(--text-main);
+  font: inherit;
+  font-size: var(--text-sm);
+}
+.seo-metrica-goals select { height: 32px; }
+.seo-metrica-goals textarea { min-height: 32px; resize: vertical; field-sizing: content; line-height: 1.4; }
+@media (max-width: 720px) {
+  .seo-metrica-goals li { grid-template-columns: minmax(0, 1fr) 150px; }
+  .seo-metrica-goals textarea { grid-column: 1 / -1; }
+}

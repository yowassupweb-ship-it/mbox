{
  "name": "mbox-vscode",
  "displayName": "MBOX",
  "description": "Проекты, задачи, память и работа агентов MBOX прямо в VS Code.",
  "version": "0.1.1",
  "publisher": "mbox",
  "private": true,
  "icon": "resources/mbox.png",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onView:mbox.projects",
    "onView:mbox.todos",
    "onView:mbox.memories",
    "onView:mbox.console",
    "onCommand:mbox.configure",
    "onCommand:mbox.refresh",
    "onCommand:mbox.nextTask",
    "onCommand:mbox.claimTask",
    "onCommand:mbox.openItem",
    "onCommand:mbox.createTask",
    "onCommand:mbox.recordMemory",
    "onCommand:mbox.openConsole",
    "onCommand:mbox.startResponders",
    "onCommand:mbox.stopResponders",
    "onCommand:mbox.showResponderStatus",
    "onCommand:mbox.installStartupResponders",
    "onCommand:mbox.uninstallStartupResponders",
    "onCommand:mbox.openWeb"
  ],
  "contributes": {
    "configuration": {
      "title": "MBOX",
      "properties": {
        "mbox.url": {
          "type": "string",
          "default": "https://mbox.shar-os.ru",
          "description": "Адрес MBOX."
        },
        "mbox.username": {
          "type": "string",
          "default": "Admin",
          "description": "Имя пользователя для входа в MBOX."
        },
        "mbox.agentName": {
          "type": "string",
          "default": "VS Code",
          "description": "Имя агента, которое уходит в заголовке x-mbox-agent и в ростер MBOX."
        },
        "mbox.project": {
          "type": "string",
          "default": "MBOX",
          "description": "Проект MBOX, который показывает расширение."
        },
        "mbox.repoPath": {
          "type": "string",
          "default": "C:\\Users\\a.nikolyuk\\Desktop\\Mbox\\memora\\memora-graph",
          "description": "Путь к локальному репозиторию MBOX со скриптами респондеров."
        },
        "mbox.autoStartResponders": {
          "type": "boolean",
          "default": true,
          "description": "Запускать респондеров Codex и Claude, пока открыт VS Code."
        },
        "mbox.codexCommand": {
          "type": "string",
          "default": "codex",
          "description": "Команда, которой запускается Codex."
        },
        "mbox.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Команда, которой запускается Claude."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mbox",
          "title": "MBOX",
          "icon": "resources/mbox.png"
        }
      ]
    },
    "views": {
      "mbox": [
        {
          "id": "mbox.projects",
          "name": "Проект",
          "icon": "resources/mbox.png"
        },
        {
          "id": "mbox.todos",
          "name": "Задачи",
          "icon": "resources/mbox.png"
        },
        {
          "id": "mbox.memories",
          "name": "Память",
          "icon": "resources/mbox.png"
        },
        {
          "id": "mbox.console",
          "name": "Консоль",
          "icon": "resources/mbox.png"
        }
      ]
    },
    "commands": [
      {
        "command": "mbox.configure",
        "title": "MBOX: Настроить подключение"
      },
      {
        "command": "mbox.refresh",
        "title": "MBOX: Обновить"
      },
      {
        "command": "mbox.nextTask",
        "title": "MBOX: Взять следующую задачу"
      },
      {
        "command": "mbox.claimTask",
        "title": "MBOX: Взять задачу в работу"
      },
      {
        "command": "mbox.openItem",
        "title": "MBOX: Открыть"
      },
      {
        "command": "mbox.createTask",
        "title": "MBOX: Создать задачу"
      },
      {
        "command": "mbox.recordMemory",
        "title": "MBOX: Записать в память"
      },
      {
        "command": "mbox.openConsole",
        "title": "MBOX: Открыть консоль"
      },
      {
        "command": "mbox.startResponders",
        "title": "MBOX: Запустить респондеров Codex и Claude"
      },
      {
        "command": "mbox.stopResponders",
        "title": "MBOX: Остановить респондеров"
      },
      {
        "command": "mbox.showResponderStatus",
        "title": "MBOX: Состояние респондеров"
      },
      {
        "command": "mbox.installStartupResponders",
        "title": "MBOX: Включить автозапуск респондеров"
      },
      {
        "command": "mbox.uninstallStartupResponders",
        "title": "MBOX: Отключить автозапуск респондеров"
      },
      {
        "command": "mbox.openWeb",
        "title": "MBOX: Открыть веб-приложение"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mbox.refresh",
          "when": "view =~ /^mbox\\./",
          "group": "navigation"
        },
        {
          "command": "mbox.createTask",
          "when": "view == mbox.todos",
          "group": "navigation"
        },
        {
          "command": "mbox.recordMemory",
          "when": "view == mbox.memories",
          "group": "navigation"
        },
        {
          "command": "mbox.openConsole",
          "when": "view == mbox.console",
          "group": "navigation"
        },
        {
          "command": "mbox.showResponderStatus",
          "when": "view == mbox.console",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mbox.claimTask",
          "when": "view == mbox.todos && viewItem == todo",
          "group": "inline"
        },
        {
          "command": "mbox.openItem",
          "when": "view =~ /^mbox\\./",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "mbox.configure"
        },
        {
          "command": "mbox.refresh"
        },
        {
          "command": "mbox.nextTask"
        },
        {
          "command": "mbox.createTask"
        },
        {
          "command": "mbox.recordMemory"
        },
        {
          "command": "mbox.openConsole"
        },
        {
          "command": "mbox.startResponders"
        },
        {
          "command": "mbox.stopResponders"
        },
        {
          "command": "mbox.showResponderStatus"
        },
        {
          "command": "mbox.installStartupResponders"
        },
        {
          "command": "mbox.uninstallStartupResponders"
        },
        {
          "command": "mbox.openWeb"
        }
      ]
    }
  }
}

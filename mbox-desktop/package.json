{
  "name": "mbox-desktop",
  "displayName": "MBOX Desktop",
  "version": "0.1.23",
  "description": "MBOX web mirror with local desktop responder controls.",
  "private": true,
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "pack": "npm run build:ui && electron-builder --dir",
    "dist": "npm run build:ui && electron-builder",
    "build:ui": "node ../scripts/build-desktop-ui.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.sharos.mbox.desktop",
    "productName": "MBOX Desktop",
    "files": [
      "launch.js",
      "main.js",
      "preload.js",
      "resources/**/*",
      "package.json",
      "localUi.js",
      "ui/**/*",
      "!node_modules/node-pty/prebuilds/darwin-*/**",
      "!node_modules/node-pty/prebuilds/win32-arm64/**",
      "!node_modules/node-pty/prebuilds/win32-x64/**/*.pdb",
      "!node_modules/node-pty/build/**",
      "!node_modules/node-pty/deps/**",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/third_party/**"
    ],
    "extraResources": [
      {
        "from": "../scripts",
        "to": "scripts",
        "filter": [
          "start-codex-responder.cmd",
          "start-claude-responder.cmd",
          "codex-chat-watcher.mjs",
          "claude-inbox-watcher.mjs",
          "sync-skills.mjs"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/mbox.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://mbox.shar-os.ru/downloads/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/node-pty/prebuilds/win32-x64/**"
    ],
    "npmRebuild": false
  }
}

{
  "name": "mbox",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "node server/mbox-server.mjs",
    "build": "vite build --outDir public --emptyOutDir false",
    "test": "node --test server/*.test.mjs scripts/*.test.mjs mbox-desktop/*.test.cjs",
    "check": "npx tsc --noEmit && npm test",
    "api:parity": "node scripts/api-parity-check.mjs",
    "ship": "vite build --outDir public --emptyOutDir false && node scripts/check-public-sync.mjs --write",
    "check:public": "node scripts/check-public-sync.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "mbox:docker:up": "docker compose -f docker-compose.mbox.yml up -d",
    "mbox:docker:down": "docker compose -f docker-compose.mbox.yml down",
    "mbox:db:tunnel": "python scripts/mbox_ssh_tunnel.py",
    "mbox:cleanup": "node scripts/mbox-maintenance.mjs cleanup",
    "mbox:sort": "node scripts/mbox-maintenance.mjs sort",
    "mbox:index": "node scripts/mbox-maintenance.mjs index",
    "mbox:codex-watch": "node scripts/codex-inbox-watcher.mjs",
    "mbox:codex-chat-watch": "node scripts/codex-chat-watcher.mjs",
    "mbox:claude-watch": "node scripts/claude-inbox-watcher.mjs",
    "mbox:skills-sync": "node scripts/sync-skills.mjs",
    "mbox:skills-pull": "node scripts/skills-pull.mjs",
    "mbox:agent-export": "node scripts/mbox-maintenance.mjs agent-export",
    "seo:wizard": "node scripts/seo-wizard-runner.mjs all step1",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@chatscope/chat-ui-kit-react": "^2.1.1",
    "@chatscope/chat-ui-kit-styles": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@univerjs/preset-docs-core": "^1.0.2",
    "@univerjs/preset-sheets-core": "^1.0.2",
    "@univerjs/presets": "^1.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.3",
    "material-icon-theme": "^5.38.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.2",
    "vite": "^6.0.7",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@browserbasehq/mcp": "^3.0.0",
    "@browserbasehq/stagehand": "^4.2.0",
    "@playwright/mcp": "^0.0.83",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.1",
    "chrome-devtools-mcp": "^1.10.1",
    "playwright": "^1.64.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
